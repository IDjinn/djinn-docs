{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Djinn",
  "scopeName": "source.djinn",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#modifiers" },
    { "include": "#operators" },
    { "include": "#attributes" },
    { "include": "#functions" },
    { "include": "#generics" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.djinn",
          "match": "//.*$"
        },
        {
          "name": "comment.block.djinn",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.djinn",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.djinn",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.djinn",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.djinn",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.djinn",
          "match": "\\b[0-9][0-9_']*\\.[0-9][0-9_']*([eE][+-]?[0-9][0-9_']*)?\\b"
        },
        {
          "name": "constant.numeric.hex.djinn",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_']*\\b"
        },
        {
          "name": "constant.numeric.binary.djinn",
          "match": "\\b0[bB][01][01_']*\\b"
        },
        {
          "name": "constant.numeric.octal.djinn",
          "match": "\\b0[oO][0-7][0-7_']*\\b"
        },
        {
          "name": "constant.numeric.integer.djinn",
          "match": "\\b[0-9][0-9_']*([eE][+-]?[0-9][0-9_']*)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.djinn",
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|async|await|spawn|yield|this|in)\\b"
        },
        {
          "name": "keyword.other.djinn",
          "match": "\\b(import|namespace|extern|struct|enum|interface|impl|where|union|new|macro|const|constexpr|consteval)\\b"
        },
        {
          "name": "constant.language.djinn",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.djinn",
          "match": "\\b(i8|i16|i32|i64|i1|u8|u16|u32|u64|f32|f64|void|string|str|auto|bool|object)\\b"
        },
        {
          "name": "storage.type.djinn",
          "match": "\\b(optional|result|size|size_long|c_result|array|map)\\b"
        },
        {
          "name": "entity.name.type.djinn",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.djinn",
          "match": "\\b(public|private|static|mut)\\b"
        },
        {
          "name": "keyword.other.accessor.djinn",
          "match": "\\b(get|set)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.djinn",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.djinn",
          "match": "(\\|\\||&&|!)"
        },
        {
          "name": "keyword.operator.arithmetic.djinn",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.djinn",
          "match": "="
        },
        {
          "name": "keyword.operator.pointer.djinn",
          "match": "(&|\\*)"
        },
        {
          "name": "keyword.operator.namespace.djinn",
          "match": "::"
        },
        {
          "name": "keyword.operator.arrow.djinn",
          "match": "=>"
        },
        {
          "name": "keyword.operator.match-arrow.djinn",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.djinn",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.variadic.djinn",
          "match": "\\.\\.\\."
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.djinn",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.attribute.begin.djinn" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.attribute.end.djinn" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name.djinn",
              "match": "[a-zA-Z_][a-zA-Z0-9_]*"
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Intrinsic functions",
          "match": "\\b(sizeof|alignof|typeof|likely|unlikely|expect)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.builtin.djinn" }
          }
        },
        {
          "name": "meta.function.djinn",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.djinn" }
          }
        },
        {
          "name": "meta.function-call.djinn",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=<[^>]*>\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.djinn" }
          }
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "name": "meta.generic.djinn",
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.generic.begin.djinn" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.generic.end.djinn" }
          },
          "patterns": [
            { "include": "#types" },
            { "include": "#generics" },
            {
              "name": "punctuation.separator.djinn",
              "match": ","
            },
            {
              "name": "storage.type.generic.parameter.djinn",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.djinn",
          "match": ";"
        },
        {
          "name": "punctuation.separator.djinn",
          "match": ","
        },
        {
          "name": "punctuation.accessor.djinn",
          "match": "\\."
        },
        {
          "name": "punctuation.section.block.begin.djinn",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.djinn",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.djinn",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.djinn",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.djinn",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.djinn",
          "match": "\\]"
        }
      ]
    }
  }
}
